@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@if (SignInManager.IsSignedIn(User)) { <span class="user-label">@User.Identity.Name</span><form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post"><button class="link-button" type="submit">Đăng xuất</button></form> } else { <a asp-area="Identity" asp-page="/Account/Login">Đăng nhập</a><a asp-area="Identity" asp-page="/Account/Register">Đăng ký</a> }
