@model IEnumerable<Category>
@{ViewData["Title"]="Quản lý thể loại";}<section class="container section"><div class="section-head"><div><p class="eyebrow">ADMIN / CATEGORIES</p><h1 class="page-title">Thể loại<span>.</span></h1></div><a class="btn btn-dark" asp-action="Create">+ Thêm thể loại</a></div><div class="table-wrap"><table><thead><tr><th>Tên</th><th>Mô tả</th><th>Số sản phẩm</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Description</td><td>@c.Products.Count</td><td class="actions"><a asp-action="Edit" asp-route-id="@c.Id">Sửa</a><a asp-action="Delete" asp-route-id="@c.Id">Xóa</a></td></tr>}</tbody></table></div><a class="back-link" asp-controller="AdminProducts" asp-action="Index">← Quản lý sản phẩm</a></section>
