@model IEnumerable<Product>
@{ViewData["Title"]="Sneakers for every move";}
<section class="hero"><div class="container hero-grid"><div><p class="eyebrow">OFFSTEP / NEW SEASON</p><h1>Find your<br/><em>next step.</em></h1><p class="hero-copy">Những thiết kế tối giản, thoải mái và linh hoạt cho mọi chuyển động mỗi ngày.</p><a class="btn btn-light" href="#products">Khám phá bộ sưu tập <span>↗</span></a></div><div class="hero-art"><div class="orbit"></div><div class="hero-shoe">OFF<br/>STEP</div><span class="hero-tag">MOVE<br/>BETTER.</span></div></div></section>
<section class="container section" id="products"><div class="section-head"><div><p class="eyebrow">THE COLLECTION</p><h2>Chọn đôi của bạn<span>.</span></h2></div><form method="get" class="search-form"><input name="q" value="@ViewBag.Query" placeholder="Tìm sản phẩm..."/><button type="submit">Tìm</button></form></div>
<div class="filters"><a class="@(ViewBag.CategoryId==null?"active":"")" asp-action="Index">Tất cả</a>@foreach(var c in (IEnumerable<Category>)ViewBag.Categories){<a class="@(ViewBag.CategoryId==c.Id?"active":"")" asp-route-categoryId="@c.Id">@c.Name</a>}</div>
<div class="product-grid">@foreach(var p in Model){<article class="product-card"><a asp-action="Details" asp-route-id="@p.Id" class="product-image"><img src="@p.ImagePath" alt="@p.Name"/><span class="product-number">0@p.Id</span></a><div class="product-meta"><span>@p.Category.Name</span><span>@(p.Stock>0?"Còn hàng":"Hết hàng")</span></div><h3><a asp-action="Details" asp-route-id="@p.Id">@p.Name</a></h3><div class="product-bottom"><strong>@p.Price.ToString("N0") ₫</strong><form asp-controller="Cart" asp-action="Add" method="post"><input type="hidden" name="id" value="@p.Id"/><button class="add-button" type="submit" disabled="@(p.Stock<=0)">+</button></form></div></article>}</div>
@if(!Model.Any()){<p class="empty-state">Chưa tìm thấy sản phẩm phù hợp.</p>}
</section>
