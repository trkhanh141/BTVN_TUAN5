@model Product
@{ViewData["Title"]="Chỉnh sửa sản phẩm";}
<section class="container section narrow"><p class="eyebrow">ADMIN / PRODUCT</p><h1 class="page-title">Chỉnh sửa sản phẩm<span>.</span></h1><form asp-action="Edit" method="post" enctype="multipart/form-data" class="checkout-form"><input type="hidden" asp-for="Id"/><div asp-validation-summary="All" class="validation"></div><label asp-for="Name"></label><input asp-for="Name"/><span asp-validation-for="Name"></span><label asp-for="Sku"></label><input asp-for="Sku"/><span asp-validation-for="Sku"></span><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea><label asp-for="Price"></label><input asp-for="Price" type="number"/><label asp-for="Stock"></label><input asp-for="Stock" type="number"/><label asp-for="CategoryId">Thể loại</label><select asp-for="CategoryId" asp-items="ViewBag.CategoryId"><option value="">-- Chọn thể loại --</option></select><label>Ảnh sản phẩm (JPG/PNG/WebP, tối đa 5 MB)</label><input type="file" name="image" accept=".jpg,.jpeg,.png,.webp"/>@if(Model?.ImagePath!=null){<img class="form-preview" src="@Model.ImagePath"/>}<label class="check-label"><input asp-for="IsFeatured"/> Sản phẩm nổi bật</label><label class="check-label"><input asp-for="IsActive"/> Đang kinh doanh</label><button class="btn btn-dark" type="submit">Lưu sản phẩm ↗</button></form></section>
