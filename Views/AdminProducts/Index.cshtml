@model IEnumerable<Product>
@{ViewData["Title"]="Quản lý sản phẩm";}
<section class="container section"><div class="section-head"><div><p class="eyebrow">ADMIN / CATALOGUE</p><h1 class="page-title">Sản phẩm<span>.</span></h1></div><a class="btn btn-dark" asp-action="Create">+ Thêm sản phẩm</a></div><div class="admin-links"><a asp-controller="AdminCategories" asp-action="Index">Quản lý thể loại →</a></div><div class="table-wrap"><table><thead><tr><th>Ảnh</th><th>Tên sản phẩm</th><th>SKU</th><th>Thể loại</th><th>Giá</th><th>Tồn kho</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td><img class="table-thumb" src="@p.ImagePath"/></td><td>@p.Name</td><td>@p.Sku</td><td>@p.Category?.Name</td><td>@p.Price.ToString("N0") ₫</td><td>@p.Stock</td><td class="actions"><a asp-action="Edit" asp-route-id="@p.Id">Sửa</a><a asp-action="Delete" asp-route-id="@p.Id">Ẩn</a></td></tr>}</tbody></table></div></section>
