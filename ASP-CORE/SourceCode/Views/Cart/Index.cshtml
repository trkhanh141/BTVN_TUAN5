@model CartViewModel
@{ViewData["Title"]="Giỏ hàng";}
<section class="container section narrow"><p class="eyebrow">YOUR SELECTION</p><h1 class="page-title">Giỏ hàng<span>.</span></h1>
@if(!Model.Items.Any()){<div class="empty-state">Giỏ hàng đang trống. <a asp-controller="Store" asp-action="Index">Tiếp tục mua sắm →</a></div>}else{<div class="cart-list">@foreach(var x in Model.Items){<div class="cart-row"><img src="@x.ImagePath" alt="@x.Name"/><div class="cart-product"><strong>@x.Name</strong><span>@x.UnitPrice.ToString("N0") ₫ / đôi</span></div><form asp-action="Update" method="post" class="qty-form"><input type="hidden" name="productId" value="@x.ProductId"/><input type="number" min="1" max="99" name="quantity" value="@x.Quantity"/><button type="submit">Cập nhật</button></form><strong>@x.Subtotal.ToString("N0") ₫</strong><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@x.ProductId"/><button class="remove-button" type="submit">×</button></form></div>}</div><div class="cart-total"><span>Tổng cộng · @Model.Count sản phẩm</span><strong>@Model.Total.ToString("N0") ₫</strong></div><div class="cart-actions"><a class="back-link" asp-controller="Store" asp-action="Index">← Tiếp tục mua</a><a class="btn btn-dark" asp-controller="Checkout" asp-action="Index">Tiến hành Checkout ↗</a></div>}
</section>
