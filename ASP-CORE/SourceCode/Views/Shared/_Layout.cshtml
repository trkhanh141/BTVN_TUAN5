<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - OFFSTEP</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<header class="site-header"><div class="container nav-wrap"><a class="brand" asp-controller="Store" asp-action="Index">OFF<span>STEP</span><small>MOVE YOUR WAY</small></a><nav><a asp-controller="Store" asp-action="Index">Cửa hàng</a><a asp-controller="Cart" asp-action="Index">Giỏ hàng</a><a asp-controller="AdminProducts" asp-action="Index">Quản trị</a></nav><div class="account"><partial name="_LoginPartial" /></div></div></header>
<main>@RenderBody()</main><footer class="footer"><div class="container footer-inner"><strong>OFFSTEP</strong><span>Everyday movement. Better comfort.</span><span>© @DateTime.Now.Year – Đỗ Trọng Khanh · 31241025367</span></div></footer>
<script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
